<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>br_perception</name>
  <version>0.1.0</version>
  <description>ROBOCON 2027 perception pipeline — LiDAR point cloud preprocessing, ground segmentation, cylinder detection, obstacle clustering, and building spot analysis</description>
  <maintainer email="user@example.com">BR Perception Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>cv_bridge</depend>
  <depend>libopencv-dev</depend>
  <depend>eigen</depend>
  <depend>builtin_interfaces</depend>
  <depend>rosidl_default_runtime</depend>
  <!-- 桥接节点用它的 CustomMsg; 外部包, 在 ~/ws_livox (非 rosdep key) -->
  <depend>livox_ros_driver2</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <!-- launch 文件运行期需要 (launch/launch_ros 解析 + rviz2 + 包路径查找) -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
