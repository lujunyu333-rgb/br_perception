<?xml version="1.0"?>
<sdf version="1.6">
  <model name="sensor_rig">
    <static>true</static>
    <link name="body">
      <pose>0 0 -0.7 0 0 0</pose>
      <visual name="v"><geometry><box><size>0.5 0.5 1.2</size></box></geometry><material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.5 0.5 1.2</size></box></geometry></collision>
    </link>
    <link name="base">
      <pose>0 0 0 0 0 0</pose>
      <visual name="v"><geometry><box><size>0.5 0.5 0.2</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      <collision name="c"><geometry><box><size>0.5 0.5 0.2</size></box></geometry></collision>
    </link>
    <link name="lidar">
      <pose>0 0 0.4 0 0 0</pose>
      <sensor name="lidar" type="ray">
        <always_on>true</always_on><update_rate>10</update_rate>
        <ray>
          <scan><horizontal><samples>360</samples><min_angle>-3.1416</min_angle><max_angle>3.1416</max_angle></horizontal><vertical><samples>16</samples><min_angle>-0.26</min_angle><max_angle>0.26</max_angle></vertical></scan>
          <range><min>0.05</min><max>15.0</max><resolution>0.01</resolution></range>
        </ray>
        <plugin name="gazebo_ros_ray_sensor" filename="libgazebo_ros_ray_sensor.so">
          <ros><remapping>~/out:=/livox/lidar/pointcloud</remapping></ros>
          <output_type>sensor_msgs/PointCloud2</output_type>
          <frame_name>livox_frame</frame_name>
        </plugin>
      </sensor>
    </link>
    <link name="cam_front">
      <pose>0 0 0.4 0 0 0</pose>
      <sensor name="cam_front_s" type="camera">
        <always_on>true</always_on><update_rate>30</update_rate>
        <camera><horizontal_fov>1.1</horizontal_fov>
          <image><width>640</width><height>384</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>30.0</far></clip></camera>
        <plugin name="gazebo_ros_camera_cam_front" filename="libgazebo_ros_camera.so">
          <ros><remapping>~/image_raw:=/camera_front/image_raw</remapping></ros>
        </plugin>
      </sensor>
    </link>
    <link name="cam_rear">
      <pose>0 0 0.4 0 0 3.1416</pose>
      <sensor name="cam_rear_s" type="camera">
        <always_on>true</always_on><update_rate>30</update_rate>
        <camera><horizontal_fov>1.1</horizontal_fov>
          <image><width>640</width><height>384</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>30.0</far></clip></camera>
        <plugin name="gazebo_ros_camera_cam_rear" filename="libgazebo_ros_camera.so">
          <ros><remapping>~/image_raw:=/camera_rear/image_raw</remapping></ros>
        </plugin>
      </sensor>
    </link>
    <link name="imu">
      <pose>0 0 0.4 0 0 0</pose>
      <sensor name="imu_s" type="imu">
        <always_on>true</always_on><update_rate>100</update_rate>
        <plugin name="gazebo_ros_imu" filename="libgazebo_ros_imu_sensor.so">
          <ros><remapping>~/out:=/imu/data</remapping></ros>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
